AI_API_KEY=
# Evaluation default. AI_API_KEY is supplied externally by the evaluator and
# must never be committed to this file.
SECONDEGO_PROVIDER=deepseek
SECONDEGO_MODEL=deepseek-flash

# Local Gemini alternative (replace the two DeepSeek values above; do not keep
# both provider/model pairs):
# SECONDEGO_PROVIDER=gemini
# SECONDEGO_MODEL=gemini-3.8-flash

# Local Groq alternative. Groq uses its own provider-specific key; do not put
# it in AI_API_KEY when using this selection:
# GROQ_API_KEY=
# SECONDEGO_PROVIDER=groq
# SECONDEGO_MODEL=openai/gpt-oss-20b

# Optional local presentation defaults. Credentials are never stored in a
# profile by SecondEgo; enter missing keys interactively for one run instead.
# SECONDEGO_PROFILE=judge
# SECONDEGO_SURFACE=terminal
# SECONDEGO_TERMINAL_MODE=events
# VOICE_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# SECONDEGO_GESTURES_ENABLED=false
