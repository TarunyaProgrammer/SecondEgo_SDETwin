{
  "name": "secondego-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "node electron/launch.cjs",
    "desktop": "npm run build && npm run electron",
    "prepare-release": "node scripts/prepare-release.cjs",
    "release-manifest": "node scripts/write-release-manifest.cjs",
    "dist:mac": "npm run build && npm run prepare-release && npx --yes electron-builder@25.1.8 --mac dmg"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
